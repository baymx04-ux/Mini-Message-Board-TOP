<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
</head>
<body>
  <h1><%= title %></h1>
  <a href="/new">New message</a>

  <ul>
    <% messages.forEach((msg, i) => { %>
      <li>
        <strong><%= msg.user %></strong>: <%= msg.text %>
        <small>(<%= msg.added.toLocaleString() %>)</small>
        <a href="/message/<%= i %>">Open</a>
      </li>
    <% }) %>
  </ul>
</body>
</html>